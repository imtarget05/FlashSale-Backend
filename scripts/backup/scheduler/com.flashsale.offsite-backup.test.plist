<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEST-ONLY variant used to demonstrate scheduled execution (Step 20):
     runs every 90 seconds. Load temporarily, capture two timestamped backup
     sets in Azure, then unload and install the daily plist instead. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.flashsale.offsite-backup.test</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__INSTALL_DIR__/repo/scripts/backup/scheduler/run-offsite-backup-scheduled.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>90</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardErrorPath</key>
  <string>/tmp/flashsale-offsite-backup-test.err</string>
  <key>StandardOutPath</key>
  <string>/tmp/flashsale-offsite-backup-test.out</string>
</dict>
</plist>
