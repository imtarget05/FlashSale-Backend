FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["src/FlashSale.Domain/FlashSale.Domain.csproj", "src/FlashSale.Domain/"]
COPY ["src/FlashSale.Application/FlashSale.Application.csproj", "src/FlashSale.Application/"]
COPY ["src/FlashSale.Infrastructure/FlashSale.Infrastructure.csproj", "src/FlashSale.Infrastructure/"]
COPY ["src/Order.Worker/Order.Worker.csproj", "src/Order.Worker/"]
RUN dotnet restore "src/Order.Worker/Order.Worker.csproj"
COPY . .
WORKDIR "/src/src/Order.Worker"
RUN dotnet publish "Order.Worker.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
# Non-root runtime (ADR-007): same pattern as the API — root-owned publish
# output is chowned to the built-in `app` user (uid 1654) with a writable
# logs/ dir for the file DLQ, then privileges are dropped.
COPY --from=build /app/publish .
# The container HEALTHCHECK probe. The worker has no HTTP listener, so the
# probe asserts what the worker REALLY does: it holds a live connection to
# the broker and is registered as an active consumer there. See the script
# for the full rationale.
COPY scripts/opsbridge-worker-healthcheck.sh /app/opsbridge-worker-healthcheck.sh
RUN mkdir -p /app/logs && chmod 0755 /app/opsbridge-worker-healthcheck.sh && chown -R app:app /app
USER app
ENTRYPOINT ["dotnet", "Order.Worker.dll"]
