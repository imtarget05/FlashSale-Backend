# .NET
bin/
obj/
*.user

# Node
node_modules/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# OS
.DS_Store

# Local env / drill artifacts (never commit)
.env
backups/*
!backups/.gitkeep
!backups/.gitignore

# Phase 3B off-host recovery drill artifacts (never commit)
# NOTE: anchored with a leading slash on purpose — a bare `recovery/` would also
# match docs/recovery/ (the backup *policy* docs, which must stay tracked).
/recovery/
/.loss-simulation-quarantine/
/logs/

# Python bytecode from repo scripts (never commit)
__pycache__/
*.pyc

# CI job artefacts of the OpsBridge browser journey (never commit).
# The job starts the API in the background and writes these two files at the
# REPOSITORY ROOT (the artefact upload step references api.log root-relative),
# so the ignore entries have to live HERE, not only in src/OpsBridge.Web/.gitignore.
api.log
api.pid
