# Local development defaults ONLY — never commit production secrets.
# Copy to .env and change values locally if needed (.env stays git-ignored).

JAVA_PAYMENT_PORT=8081
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=FlashSaleDb

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# JWT signing key for local Java service
# Must be at least 32 bytes. Keep this value local-only.
JWT_SIGNING_KEY=REQUIRED_GENERATE_SECURE_32_BYTE_KEY_HERE
APP_JWT_SECRET=REQUIRED_GENERATE_SECURE_32_BYTE_KEY_HERE

# Optional for cloud deploys; keep these values in Render/Cloudflare secrets, not in source code.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/FlashSaleDb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
