# Local development defaults ONLY — never production secrets.
# Copy to .env and change values locally if needed (.env stays git-ignored).
API_PORT=5000
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=FlashSaleDb
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Kafka is experimental/opt-in (compose profile `experimental`).
KAFKA_BOOTSTRAP=kafka:9092
