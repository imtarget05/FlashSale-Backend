# Java payment-service environment variables (copy to .env and customise)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=FlashSaleDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SIGNING_KEY=<replace-with-secure-32-byte-random-key>
PAYMENT_PORT=8080
