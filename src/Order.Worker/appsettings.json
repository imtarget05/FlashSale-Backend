{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Automation": {
    "Payment": {
      "TimeoutMinutes": 15,
      "GracePeriodMinutes": 15,
      "MaxPaymentReminders": 3,
      "ScanIntervalSeconds": 60
    },
    "Inventory": {
      "DefaultReorderThreshold": 5,
      "ScanIntervalSeconds": 60
    },
    "Reporting": {
      "RunAtHourUtc": 0,
      "ScanIntervalSeconds": 300,
      "TopProductCount": 5
    }
  },
  "AllowedHosts": "*"
}