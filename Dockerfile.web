# syntax=docker/dockerfile:1
#
# The OpsBridge WEB tier as a container image.
#
# WHY THIS FILE EXISTS
# The web app had only ever run behind `npm run dev` on port 5173, with Vite
# proxying /api to the API IN DEVELOPMENT. A built static bundle has no such
# proxy, so there was no way to deploy the web tier and have it reach the API
# at all. This image closes that gap: it serves the built SPA with nginx and
# reverse-proxies /api to the OpsBridge API, so the browser only ever talks to
# one origin (the frontend uses the RELATIVE base URL /api/v1 - see
# src/OpsBridge.Web/src/lib/api-client.ts).
#
# THE CONTRACT (this is what the Kubernetes manifest of the sibling slice
# builds against - do not change it without changing that manifest):
#
#   image            opsbridge-web:<tag>          (locally: opsbridge-web:stack-smoke)
#   listen port      8080                         (non-root friendly: > 1024)
#   runtime user     uid 1654 / gid 1654          (the repository-wide uid, ADR-007)
#   health endpoint  GET /healthz  ->  200        (answered by nginx itself)
#   writable paths   /tmp/nginx/conf.d            (the rendered server block)
#                    /tmp/nginx/cache             (nginx temp directories)
#                    /tmp/nginx/run               (the pid file)
#   upstream         $API_UPSTREAM, default http://opsbridge-api:8080
#                    (the CONTAINER port - see "THE UPSTREAM PORT" below)
#
# The three writable paths are the ONLY paths the container writes to, which
# is what makes the pod work with readOnlyRootFilesystem: true. Each of them
# must be an emptyDir volume in the manifest (with fsGroup: 1654, so uid 1654
# can write into them) - and they must be mounted ONE BY ONE: mounting /tmp
# wholesale would replace the whole /tmp tree of this image, so the
# pre-created, pre-owned conf.d, cache and run directories would be gone.
#
# ---------------------------------------------------------------------------
# THE UPSTREAM PORT: CONTAINER PORT OR SERVICE PORT?
#
# Both numbers are correct, in their own world, and which one applies depends
# on WHAT THE UPSTREAM IS:
#
#   * A CONTAINER (Docker-to-Docker - what the CI stack-smoke job does): the
#     peer is reachable on the port it LISTENS on. The API image listens on
#     8080 (Dockerfile.opsbridge: EXPOSE 8080), so
#     `http://opsbridge-api:8080` is the right address for that hop. This is
#     the image's default, because a container-to-container hop is what an
#     image can know about on its own.
#
#   * A SERVICE (Kubernetes - what the manifest does): a ClusterIP only
#     answers the ports its Service DECLARES. Service/opsbridge-api declares
#     `port: 80` (-> targetPort 8080), so the in-cluster address of the API
#     is `http://opsbridge-api:80`. A connection to
#     `http://opsbridge-api:8080` would be DROPPED by kube-proxy, even though
#     the pod behind the Service is listening on 8080.
#
# THE RULE: a ClusterIP address uses the SERVICE port; a container address
# uses the CONTAINER port. The Kubernetes manifest therefore sets
# API_UPSTREAM EXPLICITLY - it has to, because the image's default would be
# wrong there - and the validator (scripts/validate-manifests.sh, rule 10p)
# asserts that the port the manifest uses is the port the API's own Service
# declares.
# ---------------------------------------------------------------------------
#
# Same shape as the other images of the repository (Dockerfile,
# Dockerfile.payment, Dockerfile.opsbridge): a build stage and a runtime stage,
# and the runtime stage runs as a non-root user with no shell-time privilege
# escalation.
#
# ---------------------------------------------------------------------------
# BUILD STAGE - the Vite build.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app

# Dependency layer first: the lock file changes far less often than the
# sources, so the npm ci layer is cached across source-only changes.
COPY src/OpsBridge.Web/package.json src/OpsBridge.Web/package-lock.json ./
RUN npm ci --no-audit --no-fund

# The sources are copied file group by file group ON PURPOSE: `COPY
# src/OpsBridge.Web/ ./` would also copy a node_modules directory that
# happens to exist in the build context (a developer's macOS/Linux one), and
# it would overwrite the container's own, platform-correct installation with
# a foreign one. The .dockerignore of the repository does not exclude
# node_modules, and this file must not depend on a file it does not own.
COPY src/OpsBridge.Web/index.html ./
COPY src/OpsBridge.Web/vite.config.ts ./
COPY src/OpsBridge.Web/playwright.config.ts ./
COPY src/OpsBridge.Web/tsconfig*.json ./
COPY src/OpsBridge.Web/public/ ./public/
COPY src/OpsBridge.Web/src/ ./src/
COPY src/OpsBridge.Web/e2e/ ./e2e/

# `npm run build` is `tsc -b && vite build`. tsc -b also type-checks the
# Playwright specs (tsconfig.json references tsconfig.e2e.json), so a broken
# spec fails the IMAGE BUILD instead of only failing a test run later. The
# result is the static bundle in dist/.
RUN npm run build

# ---------------------------------------------------------------------------
# RUNTIME STAGE - nginx serving the bundle and proxying /api.
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS final

# The one runtime knob of the web tier: where the API is. The default is the
# API's CONTAINER port (8080) - correct for a Docker-to-Docker hop, and
# explicitly overridden by the Kubernetes manifest with the SERVICE port (80).
# See "THE UPSTREAM PORT" in the contract block above.
ENV API_UPSTREAM=http://opsbridge-api:8080 \
    NGINX_ENVSUBST_OUTPUT_DIR=/tmp/nginx/conf.d

# The runtime user: uid 1654, the same uid the other images of this
# repository use (the aspnet base images ship an `app` user with uid 1654).
RUN addgroup -g 1654 -S opsbridge \
 && adduser -u 1654 -S -G opsbridge -H -s /sbin/nologin opsbridge \
 && mkdir -p /tmp/nginx/conf.d /tmp/nginx/cache /tmp/nginx/run /usr/share/nginx/html \
 && chown -R opsbridge:opsbridge /tmp/nginx \
 && chmod 0777 /tmp/nginx/conf.d \
 && chmod 0777 /tmp/nginx/cache \
 && chmod 0777 /tmp/nginx/run

# The stock default.conf listens on port 80, which a non-root process cannot
# bind - nginx would fail to start ("bind() to 0.0.0.0:80 failed (13:
# Permission denied)"). It is replaced by an empty file: the real server
# block is rendered from the template below.
RUN printf '# Intentionally empty.\n# The OpsBridge web server block is rendered from\n# /etc/nginx/templates/opsbridge.conf.template into\n# $NGINX_ENVSUBST_OUTPUT_DIR/opsbridge.conf.\n' > /etc/nginx/conf.d/default.conf

# The built single-page application.
COPY --from=build /app/dist/ /usr/share/nginx/html/

# The template mechanism of the official nginx image: the entrypoint renders
# /etc/nginx/templates/*.template with envsubst into
# $NGINX_ENVSUBST_OUTPUT_DIR. API_UPSTREAM is substituted here, at container
# start - which is what makes one image work against any API address.
COPY src/OpsBridge.Web/nginx/opsbridge.conf.template /etc/nginx/templates/opsbridge.conf.template

# The main nginx configuration: no `user` directive (the master is not
# root), pid file and temp directories under /tmp (read-only root
# filesystem).
COPY src/OpsBridge.Web/nginx/nginx.conf /etc/nginx/nginx.conf

WORKDIR /usr/share/nginx/html
EXPOSE 8080

# Non-root runtime, asserted here and re-asserted by the manifest
# (runAsNonRoot + runAsUser).
USER 1654:1654

# Liveness probe of the web tier. wget comes from busybox, which the alpine
# base image ships - the image needs no extra package for it.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

# The base image's ENTRYPOINT (/docker-entrypoint.sh) performs the template
# rendering and then execs the CMD, which is `nginx -g "daemon off;"`.
