      WHERE "Id" IN (
          SELECT "Id"
          FROM "OutboxMessages"
          WHERE "ProcessedAt" IS NULL
            AND "DeadLetteredAt" IS NULL
            AND ("NextAttemptAt" IS NULL OR "NextAttemptAt" &lt;= @p2)
            AND ("ClaimedUntil" IS NULL OR "ClaimedUntil" &lt;= @p3)
          ORDER BY "Id"
          LIMIT @p4
          FOR UPDATE SKIP LOCKED
      )
      RETURNING *
